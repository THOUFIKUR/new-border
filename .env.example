# BorderPulse Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ─── Supabase ─────────────────────────────────────────────
# Public anon key — safe for frontend use
SUPABASE_URL=https://frmisnduadstnjwyyvym.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Service-role key — BACKEND ONLY, never expose to frontend
SUPABASE_SERVICE_ROLE_KEY=

# ─── ESP32 ────────────────────────────────────────────────
ESP32_IP=192.168.1.100
ESP32_PORT=80
ESP32_TIMEOUT_SECONDS=2
ESP32_HEARTBEAT_INTERVAL=5
ESP32_RETRY_COUNT=2
ESP32_RETRY_DELAY=1

# ─── Camera ───────────────────────────────────────────────
CAMERA_INDEX=0

# ─── YOLO ─────────────────────────────────────────────────
YOLO_MODEL=models/yolo/yolo26n.pt
YOLO_CONFIDENCE=0.50
YOLO_HUMAN_HIGH_CONFIDENCE=0.85
YOLO_IMGSZ=640
YOLO_IOU=0.45

# ─── Runtime mode ─────────────────────────────────────────
RUNTIME_MODE=laptop
SENSOR_SIMULATION=true

# ─── Evidence capture ─────────────────────────────────────
PRE_EVENT_SECONDS=5
POST_EVENT_SECONDS=8
MAX_CLIP_SECONDS=30
EVIDENCE_LOCAL_DIR=evidence_local

# ─── Decision engine ──────────────────────────────────────
EVENT_COOLDOWN_SECONDS=10
TEMPORAL_MIN_FRAMES=3
TEMPORAL_WINDOW_SECONDS=1.0

# ─── Sensor fusion weights (must sum to 1.0) ──────────────
FUSION_WEIGHT_VISION=0.55
FUSION_WEIGHT_RADAR=0.20
FUSION_WEIGHT_GROUND=0.15
FUSION_WEIGHT_TEMPORAL=0.10
FUSION_CONFIRMED_THRESHOLD=0.65

# ─── Stream ───────────────────────────────────────────────
STREAM_FPS=15
STREAM_JPEG_QUALITY=75
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# ─── Frontend (Vite uses VITE_ prefix) ───────────────────
# These go in frontend/.env, not this file
# VITE_SUPABASE_URL=https://frmisnduadstnjwyyvym.supabase.co
# VITE_SUPABASE_ANON_KEY=
# VITE_BACKEND_URL=http://localhost:8000
# VITE_WS_URL=ws://localhost:8000
